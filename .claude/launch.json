{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && source venv/bin/activate && uvicorn app.main:app --port 8000 --reload"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- --port 5173"],
      "port": 5173
    },
    {
      "name": "unified",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "./run.sh"],
      "port": 8010
    }
  ]
}
