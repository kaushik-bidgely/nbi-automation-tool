# Copy to .env and load before starting uvicorn (or export these directly)
# for anything other than local dev.

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# How long a login session stays valid before re-authentication is required.
SESSION_TTL_HOURS=168

# SQLite file path. On a cloud host with an ephemeral filesystem, point this
# at a mounted persistent volume or the DB resets on every redeploy/restart.
DATABASE_URL=sqlite:///./nbi_tool.db
